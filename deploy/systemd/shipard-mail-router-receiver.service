[Unit]
Description=Shipard mail-router — LMTP receiver
After=network.target
PartOf=shipard-mail-router.target

[Service]
Type=simple
User=shipard-mail-router
Group=shipard-mail-router
RuntimeDirectory=shipard-mail-router
RuntimeDirectoryMode=0775
ExecStart=/opt/shipard-mail-router/venv/bin/shipard-mail-router-receiver
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/shipard-mail-router /run/shipard-mail-router

[Install]
WantedBy=shipard-mail-router.target
