[Unit]
Description=Shipard mail-router — lookup.json sync from hosting (oneshot)
After=network.target
Wants=network-online.target

[Service]
Type=oneshot
User=shipard-mail-router
Group=shipard-mail-router
ExecStart=/opt/shipard-mail-router/venv/bin/shipard-mail-router-lookup-sync
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Atomic write happens in the lookup directory (temp + rename) —
# /etc is read-only under ProtectSystem=strict, so whitelist it.
ReadWritePaths=/etc/shipard-mail-router
